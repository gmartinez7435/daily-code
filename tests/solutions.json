{
  "welcome": "window.solve = function(input){const name=input.trim();return `Welcome, ${name}!`;};",
  "packing": "window.solve = function(input){let balance=input.budget;balance-=input.price*input.quantity;return balance;};",
  "initials": "window.solve = function(input){return input.trim()?input.trim().split(/\\s+/).map(w=>w[0].toUpperCase()).join(\"\"):\"\";};",
  "temperature": "window.solve = function(input){return input*9/5+32;};",
  "receipt": "window.solve = function(input){return `${input.item}: $${input.price.toFixed(2)}`;};",
  "admission": "window.solve = function(input){if(input<5)return 0;if(input<18)return 8;return 15;};",
  "shipping": "window.solve = function(input){return input.member||input.total>=50?\"free\":\"paid\";};",
  "clamp": "window.solve = function(input){return Math.min(100,Math.max(0,input));};",
  "duration": "window.solve = function(input){return `${Math.floor(input/60)}:${String(input%60).padStart(2,\"0\")}`;};",
  "slug": "window.solve = function(input){return input.trim().toLowerCase().replace(/\\s+/g,\"-\");};",
  "extension": "window.solve = function(input){const i=input.lastIndexOf(\".\");return i<0||i===input.length-1?\"none\":input.slice(i+1).toLowerCase();};",
  "reading": "window.solve = function(input){const s=input.trim();return s?Math.ceil(s.split(/\\s+/).length/200):0;};",
  "discount": "window.solve = function(input){return Number((input.price*(1-input.percent/100)).toFixed(2));};",
  "leap": "window.solve = function(input){return input%400===0||(input%4===0&&input%100!==0);};",
  "range": "window.solve = function(input){const out=[];for(let n=input.start;n<=input.end;n+=input.step)out.push(n);return out;};",
  "factorial": "window.solve = function(input){let product=1;for(let i=2;i<=input;i++)product*=i;return product;};",
  "fizzbuzz": "window.solve = function(input){const out=[];for(let i=1;i<=input;i++)out.push(i%15===0?\"FizzBuzz\":i%3===0?\"Fizz\":i%5===0?\"Buzz\":String(i));return out;};",
  "squares": "window.solve = function(input){return input.map(side=>side*side);};",
  "hot-days": "window.solve = function(input){return input.filter(n=>n>=90);};",
  "inventory": "window.solve = function(input){const item=input.items.find(x=>x.id===input.id);return item?item.name:\"Not found\";};",
  "basket": "window.solve = function(input){return input.reduce((sum,x)=>sum+x.price*x.quantity,0);};",
  "average": "window.solve = function(input){return input.length?input.reduce((a,b)=>a+b,0)/input.length:null;};",
  "unique": "window.solve = function(input){return [...new Set(input)];};",
  "sort": "window.solve = function(input){return [...input].sort((a,b)=>a.time-b.time).map(x=>x.name);};",
  "chunk": "window.solve = function(input){const out=[];for(let i=0;i<input.items.length;i+=input.size)out.push(input.items.slice(i,i+input.size));return out;};",
  "flatten": "window.solve = function(input){return input.flat(1);};",
  "frequency": "window.solve = function(input){const out=Object.create(null);for(const w of input.toLowerCase().trim().split(/\\s+/).filter(Boolean))out[w]=(out[w]||0)+1;return out;};",
  "group": "window.solve = function(input){return input.reduce((out,b)=>{(out[b.genre]??=[]).push(b.title);return out;},Object.create(null));};",
  "profile": "window.solve = function(input){const {name=\"Guest\",city=\"Unknown\"}=input;return `${name} · ${city}`;};",
  "settings": "window.solve = function(input){return {...input.current,...input.patch};};",
  "stock": "window.solve = function(input){return input.items.map(x=>x.id===input.id?{...x,stock:x.stock+input.amount}:x);};",
  "intersection": "window.solve = function(input){const b=new Set(input.b);return [...new Set(input.a)].filter(x=>b.has(x));};",
  "anagram": "window.solve = function(input){const normalize=s=>s.toLowerCase().replace(/\\s/g,\"\").split(\"\").sort().join(\"\");return normalize(input[0])===normalize(input[1]);};",
  "search": "window.solve = function(input){const q=input.query.trim().toLowerCase();return input.items.filter(x=>x.name.toLowerCase().includes(q)).map(x=>x.name);};",
  "pagination": "window.solve = function(input){const start=(input.page-1)*input.pageSize;return input.items.slice(start,start+input.pageSize);};",
  "median": "window.solve = function(input){if(!input.length)return null;const a=[...input].sort((a,b)=>a-b),m=Math.floor(a.length/2);return a.length%2?a[m]:(a[m-1]+a[m])/2;};",
  "transpose": "window.solve = function(input){return input.length?input[0].map((_,c)=>input.map(row=>row[c])):[];};",
  "run-length": "window.solve = function(input){let out=\"\";for(let i=0;i<input.length;){let j=i+1;while(input[j]===input[i]&&j<input.length)j++;out+=input[i]+(j-i);i=j;}return out;};",
  "brackets": "window.solve = function(input){const stack=[],pairs={\")\":\"(\",\"]\":\"[\",\"}\":\"{\"};for(const c of input){if(\"([{ \".trim().includes(c))stack.push(c);else if(pairs[c]&&stack.pop()!==pairs[c])return false;}return stack.length===0;};",
  "query": "window.solve = function(input){return Object.entries(input).map(([k,v])=>`${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join(\"&\");};",
  "date-key": "window.solve = function(input){return new Date(input).toISOString().slice(0,10);};",
  "days-between": "window.solve = function(input){return (Date.parse(input[1])-Date.parse(input[0]))/86400000;};",
  "weekday": "window.solve = function(input){const day=new Date(input).getUTCDay();return day===0||day===6;};",
  "safe-json": "window.solve = function(input){try{return {ok:true,value:JSON.parse(input)}}catch{return {ok:false,value:null}}};",
  "validate-record": "window.solve = function(input){const errors=[];if(!input.name.trim())errors.push(\"Name required\");if(!Number.isInteger(input.age)||input.age<18)errors.push(\"Adult required\");return errors;};",
  "nested-total": "window.solve = function(input){function total(x){return Array.isArray(x)?x.reduce((s,v)=>s+total(v),0):x}return total(input);};",
  "binary-search": "window.solve = function(input){let low=0,high=input.items.length-1;while(low<=high){const mid=Math.floor((low+high)/2);if(input.items[mid]===input.target)return mid;if(input.items[mid]<input.target)low=mid+1;else high=mid-1;}return -1;};",
  "intervals": "window.solve = function(input){const a=input.map(x=>[...x]).sort((a,b)=>a[0]-b[0]),out=[];for(const x of a){const last=out.at(-1);if(last&&x[0]<=last[1])last[1]=Math.max(last[1],x[1]);else out.push(x);}return out;};",
  "diff": "window.solve = function(input){return [...new Set([...Object.keys(input.before),...Object.keys(input.after)])].filter(k=>!(k in input.before)||!(k in input.after)||input.before[k]!==input.after[k]).sort();};",
  "money-split": "window.solve = function(input){const base=Math.floor(input.cents/input.people),extra=input.cents%input.people;return Array.from({length:input.people},(_,i)=>base+(i<extra?1:0));};",
  "counter": "let n=0;const out=document.querySelector(\"#count\");document.querySelector(\"#plus\").onclick=()=>out.textContent=++n;document.querySelector(\"#minus\").onclick=()=>out.textContent=n=Math.max(0,n-1);document.querySelector(\"#reset\").onclick=()=>out.textContent=n=0;",
  "mood": "document.querySelectorAll(\"[data-color]\").forEach(b=>b.onclick=()=>{document.querySelector(\"#swatch\").style.backgroundColor=b.dataset.color;document.querySelector(\"#choice\").textContent=b.textContent;});",
  "tip-ui": "document.querySelector(\"#form\").onsubmit=e=>{e.preventDefault();document.querySelector(\"#total\").textContent=(Number(document.querySelector(\"#bill\").value)*(1+Number(document.querySelector(\"#percent\").value)/100)).toFixed(2);}",
  "tasks": "const i=document.querySelector(\"#task\"),list=document.querySelector(\"#list\");document.querySelector(\"#add\").onclick=()=>{if(!i.value.trim())return;const li=document.createElement(\"li\");li.textContent=i.value.trim();li.onclick=()=>li.remove();list.append(li);i.value=\"\";};",
  "characters": "document.querySelector(\"#message\").oninput=e=>document.querySelector(\"#count\").textContent=e.target.value.length;",
  "greeting-ui": "document.querySelector(\"#greet\").onclick=()=>{const n=document.querySelector(\"#name\").value.trim();document.querySelector(\"#greeting\").textContent=n?`Hello, ${n}!`:\"Enter a name\";};",
  "theme": "document.querySelector(\"#toggle\").onclick=e=>e.target.setAttribute(\"aria-pressed\",String(document.querySelector(\"#card\").classList.toggle(\"dark\")));",
  "accordion": "document.querySelector(\"#question\").onclick=e=>{const a=document.querySelector(\"#answer\");a.hidden=!a.hidden;e.target.setAttribute(\"aria-expanded\",String(!a.hidden));};",
  "password-ui": "document.querySelector(\"#password\").oninput=e=>document.querySelector(\"#strength\").textContent=e.target.value.length>=8&&/\\d/.test(e.target.value)?\"Ready\":\"Keep going\";",
  "word-ui": "document.querySelector(\"#text\").oninput=e=>{const t=e.target.value.trim();document.querySelector(\"#words\").textContent=t?t.split(/\\s+/).length:0;};",
  "tabs": "const tabs=document.querySelectorAll(\"[data-content]\");tabs.forEach(t=>t.onclick=()=>{tabs.forEach(x=>x.classList.remove(\"active\"));t.classList.add(\"active\");document.querySelector(\"#panel\").textContent=t.dataset.content;});",
  "progress-ui": "let p=0;document.querySelector(\"#advance\").onclick=()=>{p=Math.min(100,p+25);document.querySelector(\"#value\").textContent=p;document.querySelector(\"#bar\").style.width=p+\"%\";};",
  "quiz-ui": "document.querySelectorAll(\"[data-correct]\").forEach(b=>b.onclick=()=>document.querySelector(\"#feedback\").textContent=b.dataset.correct===\"true\"?\"Correct\":\"Try again\");",
  "expense-ui": "let total=0;document.querySelector(\"#add\").onclick=()=>{const n=Number(document.querySelector(\"#amount\").value);if(n>0)total+=n;document.querySelector(\"#total\").textContent=total.toFixed(2);};",
  "email-form": "document.querySelector(\"#signup\").onsubmit=e=>{e.preventDefault();document.querySelector(\"#message\").textContent=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(document.querySelector(\"#email\").value)?\"Accepted\":\"Invalid email\";};",
  "favorites-ui": "const s=new Set();document.querySelectorAll(\"[data-food]\").forEach(b=>b.onclick=()=>{if(s.has(b.dataset.food))return;s.add(b.dataset.food);const li=document.createElement(\"li\");li.textContent=b.dataset.food;document.querySelector(\"#favorites\").append(li);});",
  "calculator-ui": "document.querySelectorAll(\"[data-op]\").forEach(b=>b.onclick=()=>{const a=Number(document.querySelector(\"#a\").value),n=Number(document.querySelector(\"#b\").value),op=b.dataset.op;document.querySelector(\"#result\").textContent=op===\"+\"?a+n:op===\"-\"?a-n:op===\"*\"?a*n:n===0?\"Cannot divide by zero\":a/n;});",
  "live-filter": "document.querySelector(\"#search\").oninput=e=>document.querySelectorAll(\"li\").forEach(li=>li.hidden=!li.textContent.toLowerCase().includes(e.target.value.trim().toLowerCase()));",
  "delegation": "document.querySelector(\"#list\").onclick=e=>{const b=e.target.closest(\".remove\");if(b)b.closest(\"li\").remove();};",
  "select-all": "const m=document.querySelector(\"#all\"),items=[...document.querySelectorAll(\".item\")];m.onchange=()=>items.forEach(i=>i.checked=m.checked);items.forEach(i=>i.onchange=()=>m.checked=items.every(x=>x.checked));",
  "stepper": "let i=0;const s=[...document.querySelectorAll(\"section\")],back=document.querySelector(\"#back\"),next=document.querySelector(\"#next\");function render(){s.forEach((x,n)=>x.hidden=n!==i);back.disabled=i===0;next.disabled=i===s.length-1;}back.onclick=()=>{i=Math.max(0,i-1);render();};next.onclick=()=>{i=Math.min(s.length-1,i+1);render();};render();",
  "sort-table": "document.querySelector(\"#sort\").onclick=()=>{const p=document.querySelector(\"#rows\");[...p.children].sort((a,b)=>Number(a.dataset.score)-Number(b.dataset.score)).forEach(x=>p.append(x));};",
  "cart-ui": "const q=[...document.querySelectorAll(\"[data-price]\")];q.forEach(x=>x.oninput=()=>document.querySelector(\"#total\").textContent=q.reduce((s,x)=>s+Number(x.value)*Number(x.dataset.price),0).toFixed(2));",
  "rating": "const stars=document.querySelectorAll(\"[data-star]\");stars.forEach(b=>b.onclick=()=>{const n=Number(b.dataset.star);document.querySelector(\"#rating\").textContent=n;stars.forEach(s=>s.classList.toggle(\"selected\",Number(s.dataset.star)<=n));});",
  "safe-comment": "document.querySelector(\"#form\").onsubmit=e=>{e.preventDefault();const t=document.querySelector(\"#comment\").value.trim();if(!t)return;const p=document.createElement(\"p\");p.textContent=t;document.querySelector(\"#comments\").append(p);};",
  "storage-note": "const n=document.querySelector(\"#note\");n.value=localStorage.getItem(\"note\")??\"\";n.oninput=()=>localStorage.setItem(\"note\",n.value);",
  "storage-theme": "const c=document.querySelector(\"#card\");c.classList.toggle(\"dark\",localStorage.getItem(\"theme\")===\"dark\");document.querySelector(\"#toggle\").onclick=()=>localStorage.setItem(\"theme\",c.classList.toggle(\"dark\")?\"dark\":\"light\");",
  "storage-list": "let books=[];try{const b=JSON.parse(localStorage.getItem(\"books\")||\"[]\");if(Array.isArray(b))books=b;}catch{}const list=document.querySelector(\"#books\");function render(){list.replaceChildren();books.forEach(t=>{const li=document.createElement(\"li\");li.textContent=t;list.append(li);});}render();document.querySelector(\"#add\").onclick=()=>{const t=document.querySelector(\"#title\").value.trim();if(!t)return;books.push(t);localStorage.setItem(\"books\",JSON.stringify(books));render();};",
  "stopwatch": "let n=0,t=null;const o=document.querySelector(\"#seconds\");const stop=()=>{clearInterval(t);t=null;};document.querySelector(\"#start\").onclick=()=>{if(t!==null)return;t=setInterval(()=>o.textContent=++n,1000);};document.querySelector(\"#stop\").onclick=stop;document.querySelector(\"#reset\").onclick=()=>{stop();o.textContent=n=0;};",
  "countdown": "let t=null;const o=document.querySelector(\"#count\");document.querySelector(\"#start\").onclick=()=>{if(t!==null)return;let n=3;o.textContent=n;t=setInterval(()=>{o.textContent=--n;if(n===0){clearInterval(t);t=null;}},1000);};",
  "debounce": "let t;document.querySelector(\"#search\").oninput=e=>{clearTimeout(t);const v=e.target.value;t=setTimeout(()=>document.querySelector(\"#result\").textContent=v,300);};",
  "toast": "const t=document.querySelector(\"#toast\");let id;document.querySelector(\"#notify\").onclick=()=>{clearTimeout(id);t.hidden=false;id=setTimeout(()=>t.hidden=true,500);};document.querySelector(\"#dismiss\").onclick=()=>{clearTimeout(id);t.hidden=true;};",
  "undo": "const removed=[],list=document.querySelector(\"#list\");document.querySelector(\"#delete\").onclick=()=>{const li=list.lastElementChild;if(li){removed.push(li.textContent);li.remove();}};document.querySelector(\"#undo\").onclick=()=>{if(!removed.length)return;const li=document.createElement(\"li\");li.textContent=removed.pop();list.append(li);};",
  "number-guess": "document.querySelector(\"#check\").onclick=()=>{const n=Number(document.querySelector(\"#guess\").value);document.querySelector(\"#feedback\").textContent=n<7?\"Too low\":n>7?\"Too high\":\"Correct\";};",
  "unit-ui": "const d=document.querySelector(\"#distance\"),u=document.querySelector(\"#unit\");function render(){const n=Number(d.value);document.querySelector(\"#result\").textContent=(u.value===\"km-mi\"?n*0.621371:n/0.621371).toFixed(2);}d.oninput=render;u.onchange=render;",
  "fetch-user": "window.solve = async function(input){return (await(await fetch(`/api/users/${input}`)).json()).name;};",
  "fetch-products": "window.solve = async function(input){return (await(await fetch(\"/api/products\")).json()).filter(p=>p.price<=input).map(p=>p.name);};",
  "fetch-status": "window.solve = async function(input){const r=await fetch(`/api/users/${input}`);return r.ok?(await r.json()).name:\"User unavailable\";};",
  "fetch-catch": "window.solve = async function(input){try{return await(await fetch(input)).json();}catch{return {error:\"Could not load\"};}};",
  "parallel": "window.solve = async function(input){const [u,p]=await Promise.all([fetch(`/api/users/${input}`),fetch(\"/api/products\")]);const [user,products]=await Promise.all([u.json(),p.json()]);return {name:user.name,productCount:products.length};};",
  "retry": "window.solve = async function(input){for(let i=0;i<2;i++){try{const r=await fetch(input);if(!r.ok)throw Error(\"HTTP\");return await r.json();}catch{}}return null;};",
  "pages-api": "window.solve = async function(input){let next=\"/api/pages/1\",items=[];while(next){const p=await(await fetch(next)).json();items.push(...p.items);next=p.next;}return items;};",
  "settled": "window.solve = async function(input){const r=await Promise.allSettled(input.map(async p=>{const r=await fetch(p);if(!r.ok)throw Error(\"HTTP\");return r.json();}));return r.filter(x=>x.status===\"fulfilled\").map(x=>x.value);};",
  "post": "window.solve = async function(input){return (await fetch(\"/api/rsvp\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify(input)})).json();};",
  "module-money": "import { formatMoney } from \"@practice/money\";\nwindow.solve = function(input){return formatMoney(input);};",
  "module-stats": "import {mean,extent} from \"@practice/stats\";\nwindow.solve = function(input){return {average:mean(input),range:extent(input)};};",
  "module-dynamic": "window.solve = async function(input){const {formatMoney}=await import(\"@practice/money\");return formatMoney(input);};",
  "async-ui": "const b=document.querySelector(\"#load\"),o=document.querySelector(\"#result\");b.onclick=async()=>{if(b.disabled)return;b.disabled=true;o.textContent=\"Loading…\";try{o.textContent=(await(await fetch(\"/api/users/1\")).json()).name;}finally{b.disabled=false;}};",
  "race-ui": "let latest=0;document.querySelector(\"#search\").oninput=async e=>{const id=++latest;const d=await(await fetch(\"/api/search?q=\"+encodeURIComponent(e.target.value))).json();if(id===latest)document.querySelector(\"#result\").textContent=d.label;};",
  "abort-ui": "let c=null;const o=document.querySelector(\"#status\");document.querySelector(\"#load\").onclick=async()=>{if(c)return;c=new AbortController();o.textContent=\"Loading…\";try{await fetch(\"/api/slow\",{signal:c.signal});o.textContent=\"Finished\";}catch(e){o.textContent=e.name===\"AbortError\"?\"Cancelled\":\"Error\";}finally{c=null;}};document.querySelector(\"#cancel\").onclick=()=>c?.abort();"
}
